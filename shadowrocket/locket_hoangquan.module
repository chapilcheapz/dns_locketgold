#!name=Locket Gold & Anti-Revoke - Hoàng Quân
#!desc=Mở khóa Locket Gold VIP + Chặn thu hồi chứng chỉ (Anti-Revoke) & Chặn quảng cáo by Hoàng Quân
# 🚀 Customized by Hoàng Quân

[General]
user-agent = Locket/1.0.0 (iPhone; iOS 26.3; Scale/3.00)

[Rule]
# === 1. CHẶN THU HỒI CHỨNG CHỈ APPLE (ANTI-REVOKE TOÀN DIỆN) ===
DOMAIN,ocsp.apple.com,REJECT
DOMAIN,ocsp2.apple.com,REJECT
DOMAIN,crl.apple.com,REJECT
DOMAIN,ppq.apple.com,REJECT
DOMAIN,app-attest.apple.com,REJECT
DOMAIN,vpp.itunes.apple.com,REJECT
DOMAIN,gdmf.apple.com,REJECT
DOMAIN-SUFFIX,certs.apple.com,REJECT

# === 2. CHẶN TRACKING LOGGING & QUẢNG CÁO RÁC ===
DOMAIN,firebaselogging.googleapis.com,REJECT
DOMAIN,firebaseremoteconfigrealtime.googleapis.com,REJECT
DOMAIN,logs.ads.vungle.com,REJECT
DOMAIN,ad.youtube.com,REJECT
DOMAIN,ads.youtube.com,REJECT
DOMAIN,googleads.g.doubleclick.net,REJECT
DOMAIN,pagead2.googlesyndication.com,REJECT

[Script]
# ~ Locket Gold - Shadowrocket / Surge / LanceX

# RevenueCat Response
revenuecat = type=http-response, pattern=^https:\/\/api\.revenuecat\.com\/.+\/(receipts$|subscribers\/[^/]+$), script-path=https://raw.githubusercontent.com/chapilcheapz/dns_locketgold/main/shadowrocket/scripts/locket_revenuecat.js, requires-body=true, max-size=-1, timeout=60

# RevenueCat Request Header
deleteHeader = type=http-request, pattern=^https:\/\/api\.revenuecat\.com\/.+\/(receipts|subscribers), script-path=https://raw.githubusercontent.com/chapilcheapz/dns_locketgold/main/shadowrocket/scripts/locket_header.js, timeout=60

# Locket Firebase Remote Config
locket_rc = type=http-response, pattern=^https:\/\/firebaseremoteconfig\.googleapis\.com\/v1\/projects\/locket-4252a\/.+, script-path=https://raw.githubusercontent.com/chapilcheapz/dns_locketgold/main/shadowrocket/scripts/locket_remote_config.js, requires-body=true, max-size=-1, timeout=60

# Locket Camera Filter Generator (Khung & AI Filter)
locket_filter = type=http-request, pattern=^https:\/\/api\.locketcamera\.com\/(generateFilteredImage|uploads\/ai_filters\/), script-path=https://raw.githubusercontent.com/chapilcheapz/dns_locketgold/main/shadowrocket/scripts/locket_filter.js, requires-body=true, max-size=-1, timeout=60

[MITM]
hostname = %APPEND%, api.revenuecat.com, firebaseremoteconfig.googleapis.com, api.locketcamera.com
